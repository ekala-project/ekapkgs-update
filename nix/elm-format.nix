# elm-format, built from source with ekapkgs' Haskell package set.
#
# ekapkgs does not package elm-format, and upstream does not publish it to
# Hackage: the executable and its three internal libraries all live in the
# one repository, so each is built here from its subdirectory. The
# derivations are written out by hand (rather than via callCabal2nix) to
# avoid import-from-derivation at evaluation time.
{
  lib,
  fetchFromGitHub,
  haskellPackages,
}:

let
  version = "0.8.8";

  src = fetchFromGitHub {
    owner = "avh4";
    repo = "elm-format";
    rev = version;
    hash = "sha256-FE0RGCLQSwonZECkpeNBYWfAph7L6aNC1z9do/bjIY4=";
  };

  common = {
    inherit version;
    license = lib.licenses.bsd3;
    homepage = "https://github.com/avh4/elm-format";
    # Upstream pins GHC 9.6 and caps containers below 0.7; ekapkgs ships
    # GHC 9.10, whose boot containers is 0.7.
    jailbreak = true;
    # The test suites need elm-format-test-lib and hspec-golden; the
    # formatter itself is what matters here.
    doCheck = false;
    doHaddock = false;
  };

  hp = haskellPackages.extend (
    self: _super: {
      avh4-lib = self.callPackage (
        {
          mkDerivation,
          array,
          base,
          bytestring,
          directory,
          filepath,
          mtl,
          pooled-io,
          process,
          relude,
          text,
        }:
        mkDerivation (
          common
          // {
            pname = "avh4-lib";
            src = "${src}/avh4-lib";
            libraryHaskellDepends = [
              array
              base
              bytestring
              directory
              filepath
              mtl
              pooled-io
              process
              relude
              text
            ];
            description = "Common utilities for elm-format";
          }
        )
      ) { };

      elm-format-markdown = self.callPackage (
        {
          mkDerivation,
          base,
          containers,
          mtl,
          text,
        }:
        mkDerivation (
          common
          // {
            pname = "elm-format-markdown";
            src = "${src}/elm-format-markdown";
            libraryHaskellDepends = [
              base
              containers
              mtl
              text
            ];
            description = "Markdown parsing for Elm documentation comments";
          }
        )
      ) { };

      elm-format-lib = self.callPackage (
        {
          mkDerivation,
          aeson,
          avh4-lib,
          base,
          bimap,
          binary,
          bytestring,
          containers,
          elm-format-markdown,
          mtl,
          optparse-applicative,
          relude,
          text,
        }:
        mkDerivation (
          common
          // {
            pname = "elm-format-lib";
            src = "${src}/elm-format-lib";
            libraryHaskellDepends = [
              aeson
              avh4-lib
              base
              bimap
              binary
              bytestring
              containers
              elm-format-markdown
              mtl
              optparse-applicative
              relude
              text
            ];
            description = "Common code used by elm-format and elm-refactor";
          }
        )
      ) { };

      elm-format = self.callPackage (
        {
          mkDerivation,
          aeson,
          ansi-wl-pprint,
          avh4-lib,
          base,
          bytestring,
          elm-format-lib,
          optparse-applicative,
          relude,
          text,
        }:
        mkDerivation (
          common
          // {
            pname = "elm-format";
            inherit src;
            isLibrary = false;
            isExecutable = true;
            # Generated by upstream's Shakefile from `git describe`.
            postPatch = ''
              mkdir -p generated
              cat > generated/Build_elm_format.hs <<EOF
              module Build_elm_format where

              gitDescribe :: String
              gitDescribe = "${version}"
              EOF
            '';
            executableHaskellDepends = [
              aeson
              ansi-wl-pprint
              avh4-lib
              base
              bytestring
              elm-format-lib
              optparse-applicative
              relude
              text
            ];
            enableSharedExecutables = false;
            description = "Source code formatter for Elm";
            mainProgram = "elm-format";
          }
        )
      ) { };
    }
  );
in
hp.elm-format
