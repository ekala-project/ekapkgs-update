# The Elm frontend of ekapkgs-update-web, compiled to a single `elm.js`.
#
# Elm resolves packages from $ELM_HOME/<elm version>/packages and only goes
# online when one is missing, so the packages pinned in
# web-frontend/elm-srcs.nix are fetched as fixed-output derivations and laid
# out there together with a registry snapshot (web-frontend/registry.dat).
# Both are generated by web-frontend/update.sh; rerun it after changing
# ekapkgs-update-web/frontend/elm.json.
{
  lib,
  stdenvNoCC,
  elm,
  fetchzip,
}:

let
  elmSrcs = import ./web-frontend/elm-srcs.nix;
  packagesDir = "$ELM_HOME/${elm.version}/packages";
  installPackage =
    name:
    { version, sha256 }:
    let
      src = fetchzip {
        url = "https://github.com/${name}/archive/${version}.tar.gz";
        inherit sha256;
      };
    in
    ''
      mkdir -p "${packagesDir}/${name}"
      cp -R ${src} "${packagesDir}/${name}/${version}"
    '';
in
stdenvNoCC.mkDerivation {
  pname = "ekapkgs-update-web-frontend";
  version =
    let
      cargo_info = builtins.fromTOML (builtins.readFile ../Cargo.toml);
    in
    cargo_info.workspace.package.version or "0.1.0";

  src = lib.fileset.toSource {
    root = ../ekapkgs-update-web/frontend;
    fileset = lib.fileset.unions [
      ../ekapkgs-update-web/frontend/elm.json
      ../ekapkgs-update-web/frontend/src
    ];
  };

  nativeBuildInputs = [ elm ];

  configurePhase = ''
    runHook preConfigure
    export ELM_HOME="$TMPDIR/elm-home"
    ${lib.concatStrings (lib.mapAttrsToList installPackage elmSrcs)}
    cp ${./web-frontend/registry.dat} "${packagesDir}/registry.dat"
    # elm writes compiled artifacts next to each package.
    chmod -R u+w "$ELM_HOME"
    runHook postConfigure
  '';

  buildPhase = ''
    runHook preBuild
    elm make src/Main.elm --optimize --output=elm.js
    runHook postBuild
  '';

  installPhase = ''
    runHook preInstall
    install -Dm644 elm.js "$out/elm.js"
    runHook postInstall
  '';

  meta = {
    description = "Elm frontend of the ekapkgs-update web dashboard";
    inherit (elm.meta) platforms;
  };
}
